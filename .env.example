LLM_BASE_URL=http://localhost:8000/v1
LLM_API_KEY=EMPTY
# Served name of the running preset: qwen | gemma | llama | qwen-mid | qwen-weak
LLM_MODEL=qwen
LLM_MAX_TOKENS=4096
LLM_ENABLE_THINKING=false

# Hugging Face token for gated models; HF_CACHE_DIR overrides the Docker weight cache mount
HF_TOKEN=
# HF_CACHE_DIR=

AGENT_MAX_STEPS=10
AGENT_TEMPERATURE=0
PROMPT_VERSION=v1

# arXiv submission-date window (ISO dates, inclusive); leave unset for no filter
ARXIV_DATE_FROM=2024-01-01 
ARXIV_DATE_TO=2025-12-31

WORKSPACE_DIR=workspace
# Optional shared PDF download cache (the evaluation runner defaults to workspace/pdf_cache)
# PDF_CACHE_DIR=workspace/pdf_cache

# The evaluation CLI uses --temperature (default 0.7) instead of AGENT_TEMPERATURE.

# Optional LangSmith tracing of every run (traces are stored in the LangSmith cloud)
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=tool-eval
