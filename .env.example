LLM_BASE_URL=http://localhost:1234/v1
LLM_API_KEY=lm-studio
LLM_MODEL=local-model
AGENT_MAX_STEPS=10
AGENT_TEMPERATURE=0
PROMPT_VERSION=v1

# arXiv submission-date window (ISO dates, inclusive); leave unset for no filter
ARXIV_DATE_FROM=2024-01-01 
ARXIV_DATE_TO=2025-12-31

WORKSPACE_DIR=workspace
# Optional shared PDF download cache (the evaluation runner defaults to workspace/pdf_cache)
# PDF_CACHE_DIR=workspace/pdf_cache

# The evaluation CLI uses --temperature (default 0.7) instead of AGENT_TEMPERATURE.
